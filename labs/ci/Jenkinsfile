// Jenkinsfile · one run in the pinned image, JUnit for the Jenkins view, HTML as artefact.
pipeline {
  agent { docker { image 'mcr.microsoft.com/playwright:v1.64.1-noble' } }
  environment {
    CI = 'true'
    PLAYWRIGHT_JUNIT_OUTPUT_FILE = 'results.xml'
  }
  stages {
    stage('e2e') {
      steps {
        sh 'npm ci'
        sh 'npx playwright test --reporter=junit,html'
      }
    }
  }
  post {
    always {
      junit 'results.xml'
      archiveArtifacts artifacts: 'playwright-report/**', allowEmptyArchive: true
    }
  }
}
